@model AiWebGymTracker.Models.Entities.Training;

@{
    ViewData["Title"] = "Edit Training Date";
}

<h2>Edit Date for Training #@Model.Id</h2>

<form asp-action="EditDate">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="DateTimeStart" class="control-label"></label>
        <input asp-for="DateTimeStart" class="form-control" type="datetime-local" />
        <span asp-validation-for="DateTimeStart" class="text-danger"></span>
    </div>
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="GetAll" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}