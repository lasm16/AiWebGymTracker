@model AiWebGymTracker.Models.Entities.Training;

@{
    ViewData["Title"] = "Edit Exercises";
}

<h2>Edit Exercises for Training #@Model.Id</h2>

<form asp-action="EditExercises">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label>Exercises</label>
        <!-- Add your exercise selection UI here -->
        <!-- This is a simplified version; you might want to use a more complex UI for selecting exercises -->
        <textarea class="form-control" name="exercises" rows="5">@string.Join("\n", Model.Exercises.Select(e => e.Name))</textarea>
    </div>
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="GetAll" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
