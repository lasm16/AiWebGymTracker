@model AiWebGymTracker.Models.Entities.Training;

@{
    ViewData["Title"] = "Create Training";
}

<h2>Create New Training</h2>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="CoachId" class="control-label"></label>
        <input asp-for="CoachId" class="form-control" />
        <span asp-validation-for="CoachId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="TraineeId" class="control-label"></label>
        <input asp-for="TraineeId" class="form-control" />
        <span asp-validation-for="TraineeId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DateTimeStart" class="control-label"></label>
        <input asp-for="DateTimeStart" class="form-control" type="datetime-local" />
        <span asp-validation-for="DateTimeStart" class="text-danger"></span>
    </div>
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="GetAll" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
