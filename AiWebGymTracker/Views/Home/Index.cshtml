@using AiWebGymTracker.Enums
@using AiWebGymTracker.Enums.PagesActionTypes
@using AiWebGymTracker.Infrastructure.Utils.WebRouters
@model AiWebGymTracker.Enums.PagesActionTypes.MainPageActionTypes

@{
    ViewData["Title"] = "Home Page";
}

<div style="text-align: right; padding: 10px;">
    <a href="/api" class="btn btn-primary" target="_blank">
        <i class="fas fa-book"></i> API Documentation
    </a>
</div>

<div id="content">
    <div class="service-container">
        @foreach (var service in Enum.GetValues(typeof(MainPageActionTypes)))
        {
            var (controller, action) = PageRouter.GetRoute((MainPageActionTypes)service);
            <form asp-controller="@controller" asp-action="@action" method="post">
                <button type="submit" class="service">
                        <div class="icon"><i class="fas fa-plus-circle"></i></div>
                        <div class="text-content">
                            <h3 class="title">@service.ToString()</h3>
                    </div>
                </button>
            </form>
        }
    </div>
</div>